<Window
    x:Class="GoodByDpi_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GoodByDpi_App"
    Title="GoodbyeDPI">

    <Grid x:Name="AppRootGrid" Background="#0A0E17">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Width="1200">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0" Height="50" Padding="20,0,24,0" Background="#0A0E17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="TitleDragArea" Grid.Column="0" Grid.ColumnSpan="2" Background="Transparent">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Image Source="ms-appx:///Assets/logo.png" Width="26" Height="26"/>
                        <TextBlock x:Name="AppTitleBlock" Text="GoodByDpi" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" CharacterSpacing="25" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="WindowButtonsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.BackgroundTransition>
                                        <BrushTransition Duration="0:0:0.18"/>
                                    </Border.BackgroundTransition>
                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <FontIcon x:Name="SettingsIcon" Glyph="&#xE713;" FontSize="13" Foreground="#94A3B8"/>
                    </Button>

                    <Border Width="1" Height="16" Background="#1E293B" Margin="2,0,2,0"/>

                    <Button x:Name="MinimizeButton" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.BackgroundTransition>
                                        <BrushTransition Duration="0:0:0.18"/>
                                    </Border.BackgroundTransition>
                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <FontIcon x:Name="MinimizeIcon" Glyph="&#xE921;" FontSize="10.5" Foreground="#94A3B8"/>
                    </Button>

                    <Button x:Name="CloseButton" Width="36" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                    <Border.BackgroundTransition>
                                        <BrushTransition Duration="0:0:0.18"/>
                                    </Border.BackgroundTransition>
                                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <FontIcon x:Name="CloseIcon" Glyph="&#xE8BB;" FontSize="10.5" Foreground="#94A3B8"/>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <local:ActionRingButton x:Name="ActionRing" StateToggled="ActionRing_StateToggled" HorizontalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" Height="56" Padding="24,0" Background="#0A0E17" BorderBrush="#1F293D" BorderThickness="0,1,0,0">
                <Border x:Name="StatusPill" CornerRadius="12" Padding="14,6" Background="#450A0A" BorderBrush="#991B1B" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse x:Name="PillDot" Width="7" Height="7" Fill="#EF4444"/>
                        <TextBlock x:Name="PillText" Text="DEVRE DIŞI" FontSize="11" FontWeight="SemiBold" Foreground="#FCA5A5" CharacterSpacing="35"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#101726" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="10" Foreground="#38BDF8"/>
                            <TextBlock x:Name="EuPingBlock" Text="DE: -- ms" FontSize="11" FontWeight="Medium" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionBlock" Text="v1.1.0" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                    <Button x:Name="UpdateBadgeButton" Visibility="Collapsed" Padding="8,3" Background="#0284C7" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE896;" FontSize="10.5" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="UpdateBadgeText" Text="Update" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Button>
                    <Border Background="#101726" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE774;" FontSize="10" Foreground="#38BDF8"/>
                            <TextBlock x:Name="CountryPingBlock" Text="TR: -- ms" FontSize="11" FontWeight="Medium" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="LogToggleButton" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,7" Background="#101726" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <Border.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.18"/>
                                </Border.BackgroundTransition>
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="LogToggleIcon" Glyph="&#xE9D9;" FontSize="13" Foreground="#94A3B8"/>
                        <TextBlock x:Name="LogToggleText" Text="LOG" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" CharacterSpacing="30"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="LogPanel" Grid.Column="1" Background="#0D121F" BorderBrush="#1F293D" BorderThickness="1,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="LogTitleBar" Grid.Row="0" Background="#0D121F" Padding="18,0,14,0" BorderBrush="#1F293D" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="#38BDF8"/>
                    <TextBlock x:Name="LogPanelTitleBlock" Text="BAĞLANTI GÜNLÜĞÜ" FontSize="12.5" FontWeight="Bold" Foreground="#E2E8F0" CharacterSpacing="35"/>
                </StackPanel>

                <Button x:Name="LogClearBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,4" Background="#101726" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="6">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                <Border.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.18"/>
                                </Border.BackgroundTransition>
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <FontIcon x:Name="LogClearIcon" Glyph="&#xE74D;" FontSize="10" Foreground="#94A3B8"/>
                        <TextBlock x:Name="LogClearText" Text="Temizle" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Button>
            </Grid>

            <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" Padding="16,14" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="LogItemsContainer" Spacing="8">
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="SettingsOverlay" Grid.Column="0" Grid.ColumnSpan="2" Canvas.ZIndex="100" Visibility="Collapsed">
            <Border x:Name="SettingsBackdrop" Background="#D9050811" PointerPressed="SettingsBackdrop_PointerPressed"/>

            <Border Width="536" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0D121F" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="16" Padding="26,20,16,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,10,14">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#38BDF8"/>
                            <TextBlock x:Name="SettingsModalTitle" Text="AYARLAR" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" CharacterSpacing="35"/>
                        </StackPanel>

                        <Button x:Name="SettingsModalCloseIconBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                        <Border.BackgroundTransition>
                                            <BrushTransition Duration="0:0:0.18"/>
                                        </Border.BackgroundTransition>
                                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <FontIcon Glyph="&#xE8BB;" FontSize="11" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="540" Padding="0,0,22,0">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SettingsIspTitle" Text="İSS Profili ve Modu" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                <TextBlock x:Name="SettingsIspDesc" Text="Sağlayıcınıza en uygun baypas modunu seçin" FontSize="11.5" Foreground="#64748B"/>

                                <Border x:Name="PresetSelectTrigger" Background="#101726" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="8" Height="40" Padding="14,0,14,0" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xEC27;" FontSize="13" Foreground="#38BDF8" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="PresetSelectedText" Grid.Column="1" Text="Türkiye Genel / Türk Telekom" FontSize="12" FontWeight="Medium" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <FontIcon x:Name="PresetSelectChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="#1E293B"/>

                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SettingsPingCountryTitle" Text="İkinci Ping Ülkesi" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                <TextBlock x:Name="SettingsPingCountryDesc" Text="Alt çubukta ölçülecek ülkeyi belirleyin" FontSize="11.5" Foreground="#64748B"/>

                                <Border x:Name="PingCountrySelectTrigger" Background="#101726" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="8" Height="40" Padding="14,0,14,0" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="13" Foreground="#38BDF8" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="PingCountrySelectedText" Grid.Column="1" Text="Türkiye (İstanbul - 195.175.39.39)" FontSize="12" FontWeight="Medium" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <FontIcon x:Name="PingCountrySelectChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="#1E293B"/>

                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SettingsLangTitle" Text="Dil / Language" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                <TextBlock x:Name="SettingsLangDesc" Text="Uygulama arayüzü için dil seçin" FontSize="11.5" Foreground="#64748B"/>

                                <Border x:Name="LanguageSelectTrigger" Background="#101726" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="8" Height="40" Padding="14,0,14,0" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="13" Foreground="#38BDF8" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="LanguageSelectedText" Grid.Column="1" Text="English (US)" FontSize="12.5" FontWeight="Medium" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                        <FontIcon x:Name="LanguageSelectChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Border Height="1" Background="#1E293B"/>

                            <Grid x:Name="AutoStartRow" Background="Transparent" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="SettingsAutoStartTitle" Text="Windows ile Birlikte Başlat" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    <TextBlock x:Name="SettingsAutoStartDesc" Text="Bilgisayar açıldığında arka planda otomatik çalışsın" FontSize="11.5" Foreground="#64748B"/>
                                </StackPanel>

                                <Border x:Name="AutoStartToggle" Grid.Column="1" Width="50" Height="28" CornerRadius="14" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center">
                                    <Canvas Width="48" Height="26" IsHitTestVisible="False">
                                        <Ellipse x:Name="AutoStartKnob" Width="20" Height="20" Fill="#94A3B8" Canvas.Left="4" Canvas.Top="3"/>
                                    </Canvas>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="#1E293B"/>

                            <Grid x:Name="UpdateRow" Background="Transparent" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock x:Name="SettingsUpdateTitle" Text="Güncellemeleri Denetle" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                    <TextBlock x:Name="SettingsUpdateDesc" Text="GitHub üzerinden yeni sürümleri kontrol edin" FontSize="11.5" Foreground="#64748B"/>
                                </StackPanel>

                                <Button x:Name="SettingsCheckUpdateBtn" Grid.Column="1" Height="36" Padding="14,0" Background="#162238" BorderBrush="#2D3B55" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                                <Border.BackgroundTransition>
                                                    <BrushTransition Duration="0:0:0.18"/>
                                                </Border.BackgroundTransition>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon x:Name="SettingsCheckUpdateIcon" Glyph="&#xE72C;" FontSize="11" Foreground="#38BDF8"/>
                                        <TextBlock x:Name="SettingsCheckUpdateBtnText" Text="Denetle" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="#1E293B"/>

                            <StackPanel Spacing="6">
                                <TextBlock x:Name="SettingsWhitelistTitleBlock" Text="İstisna Listesi (Whitelist)" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                <TextBlock x:Name="SettingsWhitelistDescBlock" Text="DPI baypasından muaf tutulacak alan adı veya IP'ler" FontSize="11.5" Foreground="#64748B"/>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox x:Name="WhitelistInputBox" Grid.Column="0" PlaceholderText="Örn: youtube.com veya 1.1.1.1" Height="36" Background="#101726" BorderBrush="#1F293D" BorderThickness="1" Foreground="#F8FAFC" FontSize="12.5" CornerRadius="6" Margin="0,0,8,0"/>

                                    <Button x:Name="WhitelistAddBtn" Grid.Column="1" Height="36" Padding="14,0" Background="#162238" BorderBrush="#2D3B55" BorderThickness="1" CornerRadius="6">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                                                    <Border.BackgroundTransition>
                                                        <BrushTransition Duration="0:0:0.18"/>
                                                    </Border.BackgroundTransition>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="#38BDF8"/>
                                            <TextBlock x:Name="WhitelistAddBtnText" Text="Ekle" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border Background="#090D17" BorderBrush="#1F293D" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,0,0" MaxHeight="140">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                                        <StackPanel x:Name="WhitelistItemsList" Spacing="4">
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
